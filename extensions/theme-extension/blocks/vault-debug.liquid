{%- comment -%}
  Vault Debug Block
  Shows app + customer metafields to verify storefront data.
{%- endcomment -%}

<div class="vault-debug" style="border:1px solid #d0d7de;padding:16px;border-radius:8px;background:#fafbfc;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;">
  <h3 style="margin:0 0 12px 0;font-family:inherit;">Vault Debug</h3>

  <div style="margin-bottom:12px;">
    <div>Shop: {{ shop.permanent_domain | json }}</div>
    <div>Customer ID: {% if customer %}{{ customer.id | json }}{% else %}null{% endif %}</div>
    <div>Customer Email: {% if customer %}{{ customer.email | json }}{% else %}null{% endif %}</div>
  </div>

  <div style="margin-bottom:12px;">
    <strong>App Metafield: vault.campaigns</strong>
    <pre style="white-space:pre-wrap;margin:6px 0 0 0;">{% if app.metafields.vault.campaigns %}{{ app.metafields.vault.campaigns.value | json }}{% else %}null{% endif %}</pre>
  </div>

  <div style="margin-bottom:12px;">
    <strong>Customer Metafield: vault.eligible_benefits</strong>
    <pre style="white-space:pre-wrap;margin:6px 0 0 0;">{% if customer and customer.metafields.vault.eligible_benefits %}{{ customer.metafields.vault.eligible_benefits.value | json }}{% else %}null{% endif %}</pre>
  </div>

  <div>
    <strong>App Metafields (vault namespace)</strong>
    <pre style="white-space:pre-wrap;margin:6px 0 0 0;">{% if app.metafields.vault %}{{ app.metafields.vault | json }}{% else %}null{% endif %}</pre>
  </div>
</div>

{% schema %}
{
  "name": "Vault Debug",
  "target": "section",
  "settings": []
}
{% endschema %}
