{
  "name": "the-vault",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "client",
    "server"
  ],
  "scripts": {
    "build:storefront": "vite build -c packages/storefront/vite.config.ts",
    "dev:storefront": "vite build --watch -c packages/storefront/vite.config.ts",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/storefront/tsconfig.json",
    "typecheck:shared": "tsc --noEmit -p packages/shared/tsconfig.json",
    "typecheck:storefront": "tsc --noEmit -p packages/storefront/tsconfig.json"
  },
